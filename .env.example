# .env.example -- copy to .env and edit. Never commit .env.
#
# Spec env vars (docs/mcp_test_framework_mvp_spec.md Section Configuration).
# Bare names are deliberate (CONTEXT.md "Env var naming convention" -- LOCKED).
# Precedence: CLI flags > env > .env > YAML > defaults.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_TIMEOUT_SECONDS=120

# Default invocation uses uvx for zero-install. To use a globally-installed
# binary, set MCP_SERVER_COMMAND=homelab-mcp and MCP_SERVER_ARGS=[].
MCP_SERVER_COMMAND=uvx
MCP_SERVER_ARGS=["homelab-mcp"]
MCP_SERVER_TIMEOUT_SECONDS=30

# Switched in Plan 05-05 (acceptance) -- list_registered_servers fails the disambiguation rubric; tracked for upstream homelab-mcp doc fix.
TARGET_TOOL_NAME=list_keyring_credentials

JUDGE_TIMEOUT_SECONDS=120

# Optional: path to YAML overlay (CONTEXT.md "YAML config discovery").
# YAML overlay sits BELOW env in precedence -- env vars above always win.
# MCPTF_CONFIG_FILE=./config.yaml
